  cstring="${cstring// /_}"
  cstring="${cstring//-/_}"
  cstring="${cstring//./p}"
  echo $cstring
}
export -f clean_version_string

function dev_version_string(){
  dstring=$(clean_version_string $1)
  dstring=${dstring}-$(date +%Y%m%d-%H%M)
  echo $dstring
}
export -f dev_version_string



