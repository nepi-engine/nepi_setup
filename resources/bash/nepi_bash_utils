function nepiclone {
  if is_valid_internet ; then
    cd ~/
    git clone ${NEPI_REPO_ADDRESS} 
    if [[ $? -eq 0 ]]; then
      cd ${NEPI_REPO_NAME}
      git checkout main
      git submodule update --init --recursive
    else
      echo "Failed to clone NEPI Repo from ${NEPI_REPO_ADDRESS}"
    fi
  fi
}

