function fix_path(){
  sudo -v
  if [[ ! -v "$1" && -n "$1" ]]; then
      target_path=$1
      if [[ ! -e "$target_path" ]]; then
        sudo mkdir -p $target_path
        sudo chmod 0664 ${target_path} > /dev/null 2>&1
      elif is_nepi_path $target_path; then
        echo "Fixing permissions for path: ${target_path}"
        sudo chown ${CONFIG_USER}:${CONFIG_USER} ${target_path} > /dev/null 2>&1
        if [[ ! -v "$2" && "$2" =~ ^[0-7]{3,4}$ ]]; then
          sudo chmod ${2} ${target_path} > /dev/null 2>&1
        fi

      else
          echo "NEPI Folder not found at ${target_path}"
          return 1
      fi
  else
    echo "No Path Provided"
    return 1
  fi
}
export -f fix_path

