      return 2
  else
    addr=$(grep -oE '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' "$file" | head -n 1)
    if [[ -n "$addr" ]]; then
      echo $addr
    else
      return 1
    fi
  fi 

}
