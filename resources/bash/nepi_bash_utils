function netlist() {
    find_type="$1"
    
    if [[ "$find_type" == 'bridge' ]]; then
      dlist=$(nmcli -t -f DEVICE,TYPE device status | grep -E 'bridge' | cut -d: -f1)
    elif [[ "$find_type" == 'all' ]]; then
      dlist=$(nmcli -t -f DEVICE,TYPE device status | cut -d: -f1)
    elif [[ "$find_type" == 'wired' ]]; then
      dlist=$(nmcli -t -f DEVICE,TYPE device status | grep -E 'ethernet' | cut -d: -f1)
    elif [[ "$find_type" == 'wifi' ]]; then
      dlist=$(nmcli -t -f DEVICE,TYPE device status | grep -E 'wifi' | grep  -v 'wifi-' | cut -d: -f1)
    else
      dlist=$(nmcli -t -f DEVICE,TYPE device status | grep -E 'ethernet|wifi' | grep  -v 'wifi-' | cut -d: -f1)
    fi

    for word in $dlist; do

      n_device=$word
      n_type=$(nmcli -g GENERAL.TYPE device show $n_device)

      d_name=$(nmcli -g GENERAL.CONNECTION device show $n_device)
      if [[ -n $d_name ]]; then
        n_name="${d_name}"
        ips_line=$(ip -4 addr show $n_device | grep -oP '(?<=inet\s)\d+(\.\d+){3}')
        ips_list=${ips_line// | /,}
        d_ip=$(echo $ips_list | tr ',' '\n' | tac | paste -sd, -)
        if [[ -n $d_ip ]]; then
          n_ip="${d_ip// /,}"
        else
          n_ip="--"
        fi
      else
        n_name="--"
        n_ip="--"
      fi
      #echo "${d_name} : ${n_name}"
      #echo "${d_ip} : ${n_ip}"


      d_state=$(nmcli -g GENERAL.STATE device show $n_device)
      if [[  "$n_type" == 'ethernet' && "$d_state" == *"connected"* ]]; then
        n_state=connected
      elif [[  "$n_type" == 'wifi' && "$d_state" == *"connected"* && "$n_name" != "--" ]]; then
        n_state=connected
      # elif [[ "$n_type" == 'ethernet' && "$n_name" == '--' ]]; then
      #   n_state=disabled
      elif [[ "$n_type" == 'wifi' && "$d_state" == *"unavailable"* ]]; then
        n_state=disabled
      # elif [[ "$n_type" == 'ethernet' && "$n_name" != '--' ]]; then
      #   n_state=disconnected
      # elif [[ "$d_state" == *"disconnected"* ]]; then
      #   n_state=disconnected
      else
        n_state=disconnected
      fi
      #echo "${d_state} : ${n_state}"



      echo "${n_device} | ${n_type##*-} | ${n_state} | ${n_name} | ${n_ip}"
    done

