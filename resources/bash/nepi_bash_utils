function get_sw_desc() {
  os_desc=$(get_os_info)
  sw_desc=${os_desc}
  cuda_ver=$(get_cuda_version)
  if [[ -n $cuda_ver && "$cuda_ver" != '0' ]]; then
    sw_desc="${sw_desc}_cuda${cuda_ver}"
  fi
  hailo_ver=$(get_hailo_sw_version)
  if [[ -n $hailo_ver && "$hailo_ver" != '0' ]]; then
    sw_desc="${sw_desc}_hailo${hailo_ver}"
  fi
  sw_desc=$(clean_tag_string "$sw_desc")
  echo "${sw_desc}"
}
export -f get_sw_desc


function cmd_loop() {
  if [[ ! -v "$1" && -n "$1" ]]; then
    SECONDS=0
    while $1; do 
      echo "$SECONDS"
      sleep 1
    done
  else
    echo "No command string provided"
  fi
}
export -f cmd_loop



function create_ssh_key {
        sudo -v

        key_type=ed25519

        key_folder=$1
        if [[ -z $key_folder ]]; then
          key_folder=/home/${CONFIG_USER}/.ssh
        fi
        if [[ ! -d $key_folder ]]; then
          sudo mkdir -p $key_folder
        fi

        key_name=$2
        if [[ -z "$key_name" ]]; then
            key_name="nepi_$(hostname)_${CONFIG_USER}_ssh_key"
        fi 

        user_email=$3
        if [[ -z "$user_email" ]]; then
            user_email=${CONFIG_USER}@nepi.com
        fi     


        if [[ -d $key_folder && -n $key_folder ]]; then          

              key_file=${key_name}
              key_path=${key_folder}/${key_file}

             if [[ -d $key_folder && -n $key_folder ]]; then   
                      sudo chmod 0700 $key_folder
                      sudo chmod  0600 $key_folder/*
                      sudo chown -R ${CONFIG_USER}:${CONFIG_USER} $key_folder
              fi

              if [[ -f $key_path ]]; then
                  echo "Key already exists ${key_path}"
                  return 0
              fi

              ssh-keygen -t ${key_type} -f ${key_path} -q -N "" -C "${user_email}"
              eval "$(ssh-agent -s)"
              if ssh-add ${key_path} > /dev/null; then
                echo "Added key: ${key_file}"
                cat ${key_path}.pub
              else
                echo "Failed to add SSH key: ${key_file}"
              fi


              config_file=${key_folder}/config
              touch ${config_file}

              if [[ -d $key_folder && -n $key_folder ]]; then   
                sudo chmod 0700 $key_folder
                sudo chmod  0600 $key_folder/*
                sudo chown -R ${CONFIG_USER}:${CONFIG_USER} $key_folder
              fi


              if [[ -f $key_path ]]; then
                  echo "Created ssh_key ${key_file}"
                  echo "${key_path}"
                  return 0

              else
                echo "NEPI Failed to create ssh_key ${key_file}"
                return 1
              fi


        else
          echo "SSH Key folder not found ${key_folder}"
          return 2
        fi

}

export -f create_ssh_key



