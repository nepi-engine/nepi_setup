    # Check if the folder path is provided
    if [[ -z "$folder_path" ]]; then
        echo "Error: Please provide a folder path."
        return 1
    fi

    # Check if the folder exists
    if [[ ! -d "$folder_path" ]]; then
        echo "Error: Folder '$folder_path' not found."
        return 1
    fi

    # Change to the specified directory
    pushd "$folder_path" > /dev/null || return 1

    declare -a files
    for file in "$folder_path"/*; do
        if [[ -f "$file" ]]; then # Check if the item is a regular file
            filename=$(basename "$file")
            files+=( "$filename" ) # Add it to the array
            echo $filename
        fi
    done

    # Check if there are any files
    if [[ ${#files[@]} -eq 0 ]]; then
        popd > /dev/null
        return 1
    fi

    # Check if one file
    if [[ ${#files[@]} -eq 1 ]]; then
        echo "${files[0]}"
        popd > /dev/null
        return 0
    fi
    echo ""
    echo "Select a file from "${folder_path}":"
    echo "--------------------"
    echo ""
    select filename in "${files[@]}"; do
        if [[ -n "$filename" ]]; then
            selected_file="$filename"
            break
        else
            echo "Invalid selection. Please try again."
        fi
    done
    echo "You selected ${selected_file}"
    
    # Return to the original directory
    popd > /dev/null

    # Output the full path of the selected file
    if [[ -n "$selected_file" ]]; then
        echo "${selected_file}"
    fi
}
export -f select_file_from_folder

function sync_to_config_folder() {
    if [[ -n "$1" && -n "$2" ]]; then

        source_config_path=$2
        source_etc_path=${source_config_path}/etc
        source_sys_config_file=${source_etc_path}/nepi_system_config.yaml

        if [[ "$1" == 'nepi_cfg' ]]; then
            update_config_path=/opt/nepi
            update_etc_path=${update_config_path}/etc
            update_config_file=${update_etc_path}/nepi_system_config.yaml
        else
            update_folder=$1
            update_config_path=/mnt/nepi_config/${1}
            update_etc_path=${update_config_path}/etc
            update_config_file=${update_etc_path}/nepi_system_config.yaml
        fi
        
        echo "Syncing NEPI Config Folder from ${source_etc_path} to  ${update_etc_path} "

        if [[ ! -d "$update_etc_path" ]]; then
            sudo mkdir -p $update_etc_path
            sudo chown ${CONFIG_USER}:${CONFIG_USER} $update_etc_path
        fi

        # Update from dest
        if [[ -n "$source_etc_path" && "$source_etc_path" != "/etc" && -d "$source_etc_path" ]]; then

            # sudo chown -R ${CONFIG_USER}:${CONFIG_USER} /mnt/nepi_config
            # sudo chmod -R 0775 /mnt/nepi_config

            SOURCE_PATH=$source_etc_path
            UPDATE_PATH=$update_etc_path
            #echo "Syncing ETC Folder from ${SOURCE_PATH} to ${UPDATE_PATH}"
            #echo "Excluding nepi_system_config.yaml file"
            sudo rsync -arh --exclude='nepi_system_config.yaml' ${SOURCE_PATH}/ ${UPDATE_PATH}/

            if [[ ! -f "$update_config_file" ]]; then
                sudo cp -r -p $source_sys_config_file $update_config_file
            fi

            if yq eval "$update_config_file" > /dev/null; then
                : # Do Nothing
            else
                echo "YAML file '$update_config_file' is invalid. Will replace"
                sudo cp -r -p $source_sys_config_file $update_config_file
            fi

            SOURCE_PATH=${source_sys_config_file}
            UPDATE_PATH=${update_config_file}
            #echo "Syncing NEPI System Config File from ${SOURCE_PATH} to ${UPDATE_PATH}"
            sync_yaml_files $SOURCE_PATH $UPDATE_PATH

        fi
    fi
}
export -f sync_to_config_folder

function process_count(){
  pname=$1
  pcount=$(ps aux | grep "${pname}" | grep -v grep | wc -l)
  echo $pname
}
export -f process_count


