      if [ $? -ne 0 ]; then
        echo "Can't ping NEPI IP address: ${nepi_ip}"

        echo "Restarting Network"
        sudo systemctl restart networking
        wait
        ping -c 1 -W 1 $nepi_ip > /dev/null 2>&1
        if [ $? -ne 0 ]; then
          echo "Failed to connect NEPI IP address: ${nepi_ip}"
        fi
      fi
    fi
