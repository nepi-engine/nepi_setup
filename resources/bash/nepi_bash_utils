        echo "No Network Selected"
    else
        nslist=$(netlist_wired) 
        
        if ! is_not_blank $nslist; then
            echo "No Networks Found"
            return 1
        fi
        if ! netget_name $selected_net; then
            echo "Wired Network ${selected_net} NOT Found"
            return 1
        fi
        selected_net=$(netget_name $selected_net)
        if systemctl is-active --quiet NetworkManager; then
            cmd=""

            echo "Updating Network ${selected_net} with IP Address ${new_ip_netmask}"
            if [[ ${new_ip_netmask} == 'auto' ]]; then
              cmd='sudo nmcli con mod "'${selected_net}'" ipv4.method auto '
              echo $cmd
              eval "$cmd"     

              cmd='sudo nmcli con mod "'${selected_net}'" connection.autoconnect yes '
              echo $cmd
              eval "$cmd" 

              cmd='sudo nmcli connection up "'${selected_net}'"'
              #echo $cmd
              eval "$cmd"     
              echo ""

            elif [[ -n $new_ip_netmask ]]; then
                    
                    if [[ ${new_ip_netmask} != 'auto' ]]; then
                      new_ip_netmask=$(fix_ipv4_netmask $new_ip_netmask)
                      if ! is_valid_ipv4_netmask $new_ip_netmask; then
                        echo "Invalid Address/Netmask Combination ${net_ip}"
                        return 1
                      fi
                    fi
                    echo "Updating static ip to ${new_ip_netmask}"


                    if ! is_valid_ipv4 $new_gateway; then
                        new_gateway=$(netget_ip_router)
                        if ! is_valid_ipv4 $new_gateway; then
                          new_ip="${new_ip_netmask%%/*}"
                          new_octet=1
                          new_gateway="${new_ip%.*}.$new_octet"
                        fi
                    fi
                    echo "Using Gateway ${new_gateway}"


                    cmd='sudo nmcli connection modify "'${selected_net}'" \
                        ipv4.addresses '${new_ip_netmask}' \
                        ipv4.dns 8.8.8.8,8.8.4.4 \
                        ipv4.method manual \
                        ipv4.gateway '${new_gateway}
                  

                    echo $cmd
                    eval "$cmd"     

                    cmd='sudo nmcli connection up "'${selected_net}'"'
                    echo $cmd
                    eval "$cmd" 
                    sleep 1
                    ndhcp 2> /dev/null
            fi
        fi
    fi
}

