}


function nepisetup() {
sudo -v
nepi_mode=${NEPI_MODE}
echo "NEPI_MODE: ${nepi_mode}"
if [[ ${nepi_mode} == 'REMOTE' ]]; then 
  nepisetup_remote
elif [[ ${nepi_mode} == 'HOST' ]]; then 
  nepisetup_host
elif [[ ${nepi_mode} == 'SYSTEM' ]]; then 
  nepisetup_system
fi
}






