function netlist() {
    # Use 'ip -4 -o addr show' for a consistent, machine-readable output for IPv4 addresses only
    # 'awk' is then used to parse the output and format it
    nlist=$(ip -4 -o addr show | awk '{
        # $netlist2 is the interface name, $4 is the IP address in CIDR format
        split($4, a, "/"); # Split the IP/CIDR to get just the IP address
        printf "%-9s  %s |\n", $2, a[1] ;
    }')
    if is_not_blank $nlist; then
        #echo "netlist = ${nlist}"
        counter=0
        new_n=1
        for word in $nlist; do
          #echo "got ${word}"
          if [[ $counter -eq 0 ]]; then
            aname=$(nmcli -g GENERAL.CONNECTION device show ${word})
            if [[ $? -eq 0 && -n $aname ]]; then
              printf "%s " "$aname"
            else
              printf "%s " "$word"
            fi
          elif [[ $counter -eq 1 ]]; then
              printf "%s " "| ${word}"
          fi
          if [[ $new_n -eq 1 ]]; then
            last_n=$word
            new_n=0
          fi
          ((counter++))
          if [[ $((counter % 3)) == 0 ]]; then
            counter=0
            new_n=1
            skip=0
            printf "\\n"
          fi
        done
        # Add a final newline if the total count isn't a multiple of 3,
        # ensuring the last line is processed.
        if [[ $((counter % 3)) != 0 ]]; then
          printf "\\n"
        fi
    else
      echo ''
    fi

}
export -f netlist



function netliststatic() {
    # Use 'ip -4 -o addr show' for a consistent, machine-readable output for IPv4 addresses only
    # 'awk' is then used to parse the output and format it
    nlist=$(ip -4 -o addr show | awk '{
        # $netlist2 is the interface name, $4 is the IP address in CIDR format
        split($4, a, "/"); # Split the IP/CIDR to get just the IP address
        printf "%-9s  %s |\n", $2, a[1] ;
    }')
    if is_not_blank $nlist; then
      #echo "netlist = ${nlist}"
      counter=0
      new_n=1
      last_n='lo'
      skip=0
      for word in $nlist; do
        #echo "got ${word}"
        if [[ ${word} == ${last_n} || "$word" == *"l4tbr"* || "$word" == *"rndis"* || "$word" == *"wlan"* || "$word" == *"docker"* ]]; then
          #echo "skipping ${word}"
          skip=1
        fi
        if [[ $skip -eq 0 ]]; then
          if [[ $counter -eq 0 ]]; then
            aname=$(nmcli -g GENERAL.CONNECTION device show ${word})
            if [[ $? -eq 0 && -n $aname ]]; then
              printf "%s " "$aname"
            else
              skip=1
            fi
          elif [[ $counter -eq 1 ]]; then
              printf "%s " "| ${word}"
          fi
        fi
        if [[ $new_n -eq 1 ]]; then
          last_n=$word
          new_n=0
        fi
        ((counter++))
        if [[ $((counter % 3)) == 0 ]]; then
          counter=0
          new_n=1
          skip=0
          printf "\\n"
        fi
      done
      # Add a final newline if the total count isn't a multiple of 3,
      # ensuring the last line is processed.
      if [[ $((counter % 3)) != 0 ]]; then
        printf "\\n"
      fi
    else
      echo ''
    fi


}
export -f netliststatic

