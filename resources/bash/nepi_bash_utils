function netselect(){
        adapter_type=$1
        selected_net=""
        # Use 'ip -4 -o addr show' for a consistent, machine-readable output for IPv4 addresses only
        # 'awk' is then used to parse the output and format it
        if [[ "$adapter_type" == "all" ]]; then
          nslist=$(netlist 'all') 
        elif [[ "$adapter_type" == "wired" ]]; then
          nslist=$(netlist_wired) 
        elif [[ "$adapter_type" == "wifi" ]]; then
          nslist=$(netlist_wifi) 
        else
          nslist=$(netlist) 
        fi

        if ! is_not_blank $nslist; then
            echo "No Networks Found"
            return 1
        fi
        #echo $nslist
        # Set IFS to | and read into an array
        readarray -t adapters <<< "$nslist"
        # adapters=("${adapters[@]:1}")
        num_adapters=${#adapters[@]}
        #echo "Found ${num_adapters} : ${adapters}"
        
        # Check if there are any adapters
        if [[ $num_adapters -eq 0 ]]; then
            #echo "No Networks Found"
            return 1
        fi

        # Check if there are any adapters
        if [[ $num_adapters -eq 1 ]]; then
            adapter=${adapters[0]}
            delimiter=" |"
            selected_net=${adapter%%$delimiter*}
            #echo "Using adapter ${selected_net}"
        fi

        if [[ -z $selected_net ]]; then
          COLUMNS=1
          select adapter in "${adapters[@]}"; do
              if [[ -n "$adapter" ]]; then
                  delimiter=" |"
                  selected_net=${adapter%%$delimiter*}
                  break
              else
                  selected_net=""
                  echo "Invalid selection. Please try again."
              fi
          done
        fi

        
        if [[ -n $selected_net ]]; then
          echo "${selected_net}"
          return 0
        else
          echo ""
          return 1
        fi

}
export -f netselect

