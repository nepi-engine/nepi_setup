function fix_scripts(){
  sudo -v
  if [[ -v "$1" || -z "$1" ]]; then
    target_path=$(pwd)
  else
    target_path=$1
  fi
  if [[ -n "$target_path" ]]; then
    if [[ ! -e "$target_path" ]]; then
      sudo mkdir -p $target_path
    elif [[ ! -d "$target_path" ]]; then
      echo "Script path is not a found: ${target_path}"
      return 1
    fi

    if is_nepi_path $target_path; then
      echo "Fixing permissions in script folder: ${target_path}"
      sudo chown ${CONFIG_USER}:${CONFIG_USER} ${target_path}/* > /dev/null 2>&1
      sudo chmod 0776 ${target_path}/* > /dev/null 2>&1

    else
        echo "NEPI Script folder not found at ${target_path}"
        return 1
    fi
  else
    echo "No Script Path Provided"
    return 1
  fi
}
export -f fix_scripts





