function get_python_version() {
    # Check if python3 command exists
    if ! command -v python3 &> /dev/null; then
        echo "0"
        return 1
    fi

    # Extract the version number only
    pswv_long=$(python3 -V 2>&1 | awk '{print $2}')
    #echo $pswv_long
    pswv_short=$(echo "$pswv_long" | awk -F. '{print $1 "." $2}')
    echo $pswv_short
}

export -f get_python_version


function get_cuda_version(){

        if nvcc --version  >/dev/null 2>&1; then
          string=$(nvcc --version) 
          key=release
          value=$(echo "$string" | grep "${key}" | awk '{print $NF}' | cut -d'.' -f1-2)
          echo "${value#V}"
        else
          cuda_version=0
          cuda_path=/usr/local
          declare -a files
          for file in "$cuda_path"/*; do
              if [[ -d "$file" && "$file" == *cuda-* ]]; then # Check if the item is a regular file
                  cuda_version=${file##*-}
              fi
          done
          echo $cuda_version
        fi
}
export -f get_cuda_version


function get_hailo_hw_version(){
        hailo_version=0
        pci_list=$(lspci)
        hailo_split="${pci_list#*Hailo-}"
        if [[ -n $hailo_split ]]; then
          hailo_version="${hailo_split%% *}"
        else
          hailo_version=0
        fi
        echo $hailo_version
}
export -f get_hailo_hw_version


function get_hailo_sw_version(){
        hailo_version=0
        hailo_info=$(hailortcli -version) >/dev/null 2>&1
        if [[ -n $hailo_info ]] ; then
          hailo_sw="${hailo_info##* }"
          if [[ -n hailo_sw ]]; then
            hailo_version=$hailo_sw
          fi
        fi
      
        echo $hailo_version
}
export -f get_hailo_sw_version

function get_hailo_fw_version(){
        hailo_version=0
        if is_valid_hailo_hw  >/dev/null 2>&1; then
          hailo_info=$(hailortcli fw-control identify  2> /dev/null | tr -d '\0' 2>/dev/null)
          hailo_sw=$(echo $hailo_info | grep -oP 'Firmware Version: \K[0-9]+\.[0-9]+\.[0-9]+')
          hailo_sw=${hailo_sw// /}
          if [[ -n $hailo_sw ]]; then
            hailo_version=$hailo_sw
          else
            hailo_info=$(hailortcli fw-control identify 2>&1 >/dev/null | head -n 1)
            tmp="${hailo_info#*\(}"
            hailo_sw="${tmp%%\)*}"
            if [[ -n 4hailo_sw ]]; then
              hailo_version=$hailo_sw
            fi
          fi

        fi
      
        echo $hailo_version
}
export -f get_hailo_fw_version

