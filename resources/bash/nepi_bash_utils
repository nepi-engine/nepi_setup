            key_folder=$(dirname ${key_path})
            if [[ -d $key_folder && -n $key_folder ]]; then   
              sudo chmod 0700 $key_folder
              sudo chmod  0600 $key_folder/*
              sudo chown -R ${CONFIG_USER}:${CONFIG_USER} $key_folder
            fi

          return 0
      else
        echo "File not found at key path: ${key_path}"
        return 2
      fi
  else
    echo "No Key Path Provided"
    return 1
  fi



}

