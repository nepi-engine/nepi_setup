function sync_yaml_files(){
    SOURCE_FILE=$1
    TARGET_FILE=$2
    REPLACE_ENTRIES=0
    if [[ -n "$3" ]]; then
      REPLACE_ENTRIES=$3
    fi

    if [[ ! -f "$SOURCE_FILE" ]]; then
        echo "Source file does not exist: ${SOURCE_FILE}"
        return 1
    fi

    if [[ ! -f "$TARGET_FILE" ]]; then
        echo "Target file does not exist: ${TARGET_FILE}"
        return 2
    fi

    keys=($(yq e 'keys | .[]' ${SOURCE_FILE}))
    for key in "${keys[@]}"; do
        KEY_NAME="${key}" # The path to the key you want to add
        #echo "Check if the key exists for key ${KEY_NAME} in file ${TARGET_FILE}"
        if yq eval ". | has(\"$KEY_NAME\")" "$TARGET_FILE" | grep -q "false"; then
            echo "Key ${KEY_NAME} is missing. Adding it to ${TARGET_FILE} "
            KEY_VALUE=$(yq e '.'"$KEY_NAME"'' $SOURCE_FILE)      # The value for the new key
            update_yaml_value $KEY_NAME $KEY_VALUE $TARGET_FILE
            #echo "Key added successfully."
        elif [[ "$REPLACE_ENTRIES" -eq 1 ]]; then # Update the value
            #echo "Key ${KEY_NAME} exists. Will update"
            KEY_VALUE=$(yq e '.'"$KEY_NAME"'' $SOURCE_FILE)      # The value for the new key
            update_yaml_value $KEY_NAME $KEY_VALUE $TARGET_FILE
        fi        
    done

}
export -f sync_yaml_files


