    local input=$1
    ip="${input%%/*}"
    nm=''
    if [[ "$input" == *"/"* ]]; then
      nm="${input#*/}"
    fi
    if is_valid_ipv4 $ip > /dev/null 2>&1; then
      if is_valid_netmask $nm > /dev/null 2>&1; then
        echo "${ip}/${nm}"
      else
        echo "${ip}/24"
