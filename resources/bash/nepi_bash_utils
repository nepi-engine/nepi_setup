function is_wifi_ap() {
    local interface=""
    local mode=""
    local found=false

    # Iterate through all available wifi interfaces
    for interface in $(ls /sys/class/net/ 2>/dev/null); do
        # Verify it is a wifi interface by checking for the wifi extension
        if iwconfig "$interface" 2>/dev/null | grep -q "no wifi extensions"; then
            continue
        fi

        # Check the current operational mode of the adapter
        mode=$(iwconfig "$interface" 2>/dev/null | grep -o 'Mode:[A-Za-z]*' | cut -d: -f2)

        # "Master" or "AP" indicates Access Point mode
        if [[ "$mode" == "Master" ]]; then
            echo "Access Point active on interface: $interface"
            found=true
        fi
    done

    if ! $found; then
        echo "No Wi-Fi Access Point is currently set up on any adapter."
        return 1
    fi
}

export -f is_wifi_ap


