function nepiauthrm {
    sudo -v
    key_file=$1

    
    if [[ -n $key_file ]]; then

        key_folder=$NEPI_SSH_FOLDER
        key_path=${key_folder}/${key_file}

        if [[ -f $key_path ]]; then

            key_folder=$(dirname ${key_path})
            if [[ -d $key_folder && -n $key_folder ]]; then   
              sudo chmod 0700 $key_folder
              sudo chmod  0600 $key_folder/*
              sudo chown -R ${CONFIG_USER}:${CONFIG_USER} $key_folder
            fi

          authorized_keys_path="${key_folder}/authorized_keys"
          touch ${authorized_keys_path}

          key_pub=$(cat ${key_path}.pub)
          key_email="${key_pub##* }"
          echo "Removing existing key for id ${key_email}"
          if [[ -n $key_email ]]; then   
            sudo chmod 0777 $authorized_keys_path
            echo "Editing file ${authorized_keys_path}"   
            sed -i "/$key_email/d" "$authorized_keys_path"
          fi

          if sudo systemctl status >/dev/null 2>&1;  then
            sudo systemctl restart sshd
          elif sudo supervisorctl status >/dev/null 2>&1; then
            sudo supervisorctl restart nepi_ssh
          fi

          return 0
          
        else
          echo "Remove Key File Not Found: ${key_path}"
          return 1
        fi

    else
        echo "Remove Key File Not Provided"
        return 1
    fi
}

