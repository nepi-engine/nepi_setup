function path_size_kb(){
    source_path=$1
    if [[ -z "$source_path" ]]; then
      source_path=$(pwd)
    fi
    if [[ ! $source_path == /* ]]; then
      source_path=$(pwd)/${source_path}
    fi

    if is_valid_folder $source_path >/dev/null 2>&1; then
      path_size=$(sudo du -s "$source_path" | awk '{print $1}')
    fi
    if is_valid_file $source_path >/dev/null 2>&1; then
      path_size=$(sudo stat -c %s "$source_path")
      path_size=$((path_size / 1024))
    fi

    if [[ -n "$path_size" ]]; then
      path_size=$((path_size + 1))
      echo $path_size
    else
      echo 0
      return 1
    fi
}
