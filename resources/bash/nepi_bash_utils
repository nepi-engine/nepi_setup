  sudo -v
  key_path=$1
  if [[ -n $key_path ]]; then

      # Output the full path of the selected file
      if [[ -f $key_path ]]; then
          if ssh-add ${key_path} > /dev/null; then
              echo "Added SSH key: ${key_path}"
