function netadd_ip_alias(){
  net_ref=$1
  ipn_alias=$2
  ipn_alias=$(fix_ipv4_netmask "${ipn_alias}")
  ip_alias="${ipn_alias%%/*}"
  skip_update=$3
  if [[ "$skip_update" -ne 1 ]]; then
    skip_update=0
  fi
  net_name=$(netget_name $net_ref)
  #echo $net_name
  if [[ -n $net_name ]]; then
    if is_valid_ipv4_netmask $ipn_alias; then
      if netget_info $ip_alias 2> /dev/null; then
        echo "IP address allready in use ${ipn_alias}"
        netget_info $net_name
        return 1
      else
        sudo nmcli connection modify "$net_name" +ipv4.addresses "$ipn_alias"
        if [[ $skip_update -eq 0 ]]; then
          sudo nmcli connection up "$net_name"
        fi
      fi
    else
      echo "Not a valid IP address ${ipn_alias}"
      return 1
    fi 
  else
    echo "Network reference ${net_ref} not found"
    return 1
  fi 
}

export -f netadd_ip_alias


