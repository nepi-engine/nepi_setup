function nepipull(){
  sudo -v
  docker_link=$1
  if pingi; then
    start_ids=$(echo $(sudo docker images -q))
    bash ${NEPI_DOCKER_CONFIG}/nepi_docker_pull.sh $docker_link
    end_ids=$(echo $(sudo docker images -q))
    if [[ ${start_ids} != ${end_ids} ]]; then
      bash ${NEPI_DOCKER_CONFIG}/nepi_docker_start.sh
    fi
  fi
}
export -f nepipull


function nepipush(){
  sudo -v
  script_user=$(id -un)
  if [[ ${script_user} != 'root' ]]; then
      echo "This script must be run as root. Type 'sudo su' before running this process."
      return 1
  fi

  hub_tag=$1
  echo "Pushing NEPI Docker Image"
  bash ${NEPI_DOCKER_CONFIG}/nepi_docker_push.sh $hub_tag
  bash ${NEPI_DOCKER_CONFIG}/nepi_docker_start.sh
}
export -f nepipull


