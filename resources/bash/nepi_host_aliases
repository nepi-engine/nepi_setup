# Setup Connection Shortcuts
alias sshn="ssh -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p $nepi_port -i $NEPI_SSH_KEY_PATH ${NEPI_USER}@nepi"
alias sshnv="ssh -vvv -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -p $nepi_port -i $NEPI_SSH_KEY_PATH ${NEPI_USER}@nepi"
alias scpn="scp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -P $nepi_port -i $NEPI_SSH_KEY_PATH ${NEPI_USER}@nepi"
alias sftpn="sftp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -P $nepi_port -i $NEPI_SSH_KEY_PATH ${NEPI_USER}@nepi"


function sftpnl(){
sftp -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -P $nepi_port -i $NEPI_SSH_KEY_PATH ${NEPI_USER}@nepi:../.."$@"
}


