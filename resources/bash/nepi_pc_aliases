function sshnhc(){
  echo "Checking NEPI Device Clock"
  date_str=$(ssh -o StrictHostKeyChecking=no -p 22 -i $NEPI_SSH_KEY_PATH ${nepihost}@${nepihost} "date -I")
  year_str="${date_str%%-*}"
  if [[ $year_str -lt 2026 ]]; then
    echo "Upating Clock"
    ssh -o StrictHostKeyChecking=no -p 22 -i $NEPI_SSH_KEY_PATH ${nepihost}@${nepihost} "sudo -S date --set=@$(date +%s)"
  fi
  date_str=$(ssh -o StrictHostKeyChecking=no -p 22 -i $NEPI_SSH_KEY_PATH ${nepihost}@${nepihost} "date -I")
  year_str="${date_str%%-*}"
  if [[ $year_str -lt 2026 ]]; then
    echo "Failed to Update Clock"
    ssh -o StrictHostKeyChecking=no -p 22 -i $NEPI_SSH_KEY_PATH ${nepihost}@${nepihost} "sudo -S date --set=@$(date +%s)"
    return 1
  else
    echo "Remote Clock Updated to ${date_str}"
    return 0
  fi  
}
