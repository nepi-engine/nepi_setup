# Clear Known Host Keys
function ckeys(){
  kh_file=/home/${CONFIG_USER}/.ssh/known_hosts
  if [[ -f "$kh_file" ]]; then
    rm $kh_file
  fi
}
export -f ckeys


function switchnd(){
  if [[ "$NEPI_IN_CONTAINER" -eq 1 ]]; then
    echo "Switching to Device Deployment"
    UPDATE='export NEPI_IN_CONTAINER=0'
  else
    echo "Switching to Container Deployment"
    UPDATE='export NEPI_IN_CONTAINER=1'
  fi

  ## Update NEPI_IN_CONTAINER
  FILE=/home/${CONFIG_USER}/.bashrc
  KEY='export NEPI_IN_CONTAINER'
  sudo sed -i "/^$KEY/c\\$UPDATE" "$FILE"

  # Do Export Updates
  export NEPI_IN_CONTAINER=$NEPI_IN_CONTAINER
  if [[ "$NEPI_IN_CONTAINER" -eq 1 ]]; then
    nepi_port=2222
    nepihost=nepihost
  else
    nepi_port=22
    nepihost=nepi
    
  fi

  # Clear known keys
  ckeys
  
  sbrc

}

if [[ "$NEPI_IN_CONTAINER" -eq 1 ]]; then
