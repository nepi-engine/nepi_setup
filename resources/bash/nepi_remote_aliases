# NEPI SSH Agent Config
###################################

 


ssh_key_path=/home/${CONFIG_USER}/.ssh/nepi_default_ssh_key
if [[ -z NEPI_SSH_KEY_PATH ]]; then
  NEPI_SSH_KEY_PATH=$ssh_key_path
fi

nepi_port=2222

# Setup Connection Shortcuts
# Setup Connection Shortcuts
alias sshn="ssh -o StrictHostKeyChecking=no -p $nepi_port -i $NEPI_SSH_KEY_PATH ${NEPI_USER}@nepi"
alias sshnv="ssh -vvv -o StrictHostKeyChecking=no -p $nepi_port -i $NEPI_SSH_KEY_PATH ${NEPI_USER}@nepi"
alias scpn="scp -o StrictHostKeyChecking=no -P $nepi_port -i $NEPI_SSH_KEY_PATH ${NEPI_USER}@nepi"
alias sftpn="sftp -o StrictHostKeyChecking=no -P $nepi_port -i $NEPI_SSH_KEY_PATH ${NEPI_USER}@nepi"

function sftpnl(){
sftp -o StrictHostKeyChecking=no -P $nepi_port -i $NEPI_SSH_KEY_PATH ${NEPI_USER}@nepi:../.."$@"
}




function sshnhc(){
  echo "Checking NEPI Device Clock"
  date_str=$(ssh -o StrictHostKeyChecking=no -p 22 -i $NEPI_SSH_KEY_PATH ${NEPI_HOST_USER}@nepihost "date -I")
  year_str="${date_str%%-*}"
  if [[ $year_str -lt 2026 ]]; then
    echo "Upating Clock"
    ssh -o StrictHostKeyChecking=no -p 22 -i $NEPI_SSH_KEY_PATH ${NEPI_HOST_USER}@nepihost "sudo -S date --set=@$(date +%s)"
  fi
