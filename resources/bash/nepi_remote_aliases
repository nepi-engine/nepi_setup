# Setup Connection Shortcuts
function sshnh(){
  ssh -o StrictHostKeyChecking=no -p 22 -i $NEPI_SSH_KEY_PATH -t ${NEPI_HOST_USER}@nepihost "sudo -S date --set=@$(date +%s); exec bash -l"
}
function sshnhv(){
  ssh -vvv -o StrictHostKeyChecking=no -p 22 -i $NEPI_SSH_KEY_PATH -t ${NEPI_HOST_USER}@nepihost "sudo -S date --set=@$(date +%s); exec bash -l"
}

alias scpnh="scp -o StrictHostKeyChecking=no -P 22 -i $NEPI_SSH_KEY_PATH ${NEPI_HOST_USER}@nepihost"
alias sftpnh="sftp -o StrictHostKeyChecking=no -P 22 -i $NEPI_SSH_KEY_PATH ${NEPI_HOST_USER}@nepihost"


function sftpnhl(){
sftp -o StrictHostKeyChecking=no -P 22 -i $NEPI_SSH_KEY_PATH ${NEPI_HOST_USER}@nepihost:../.."$@"
}




