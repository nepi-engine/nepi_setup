
###############
# Wired Static IP In Container

INTERFACE="${NEPI_IP_INTERFACE}" # Replace with your actual network interface name (e.g., eth0, enp0s3)
IP_ADDRESS="${NEPI_IP}"
NETMASK_CIDR="24" # e.g., 24 for 255.255.255.0
if [[ "$NEPI_IP_GATEWAY" == "NONE" ||  "$NEPI_IP_GATEWAY" == "None" ]]; then
    GATEWAY=${IP_ADDRESS%.*}.1
else
    GATEWAY=$NEPI_IP_GATEWAY
fi

GATEWAY="" # Leave Blank "${NEPI_IP%.*}"
if [[ "$NEPI_DHCP_ON_START" -eq 1 ]]; then
    DNS_SERVER="8.8.8.8"
else
    DNS_SERVER=""
fi

if ip link show ${NEPI_WIRED_INTERFACE} &>/dev/null; then
    echo "${NEPI_WIRED_INTERFACE} exists."

    # Update up static IP addr if needed
    static_check=$(ip -4 address show ${NEPI_WIRED_INTERFACE})
    if [[ "$?" -eq 0 ]]; then
        nmcli connection add type ethernet ifname ${NEPI_WIRED_INTERFACE} con-name "${NEPI_IP_INTERFACE}"

        nmcli connection show
        echo "Modify the connection to use a static IP ${IP_ADDRESS}"
        sudo nmcli connection modify "$INTERFACE" \
            ipv4.method "manual" \
            ipv4.addresses "$IP_ADDRESS/$NETMASK_CIDR" \
            ipv4.gateway "$GATEWAY" \
            ipv4.dns "$DNS_SERVER"


        #### TODO: Edit conf file with NEPI_ALIAS_IPS ########## 
        ### Check to see to see if ! None
        if [[ "$NEPI_ALIAS_IPS" != "NONE" &&  "$NEPI_ALIAS_IPS" != "None" ]]; then
            # update with correct ip address
            nmcli connection modify "$INTERFACE" ipv4.addresses $NEPI_ALIAS_IPS
            nmcli connection modify "$INTERFACE" ipv4.method manual
        fi

        # Bring the connection down and then up to apply changes
        sudo nmcli connection down "$INTERFACE"
        sudo nmcli connection up "$INTERFACE"

        echo "Static IP address set for $INTERFACE to $IP_ADDRESS"
    fi


###############
# Wired Static IP NEPI Device
echo "Updating Network Interfaces"
if [ -f "${ETC_FOLDER}/network/interfaces" ]; then
    if [ -f "/etc/network/interfaces" ]; then
        sudo rm /etc/network/interfaces
    fi
    sudo cp -a -r ${ETC_FOLDER}/network/interfaces /etc/network/interfaces
else
    echo "FAILED TO FIND SOURCE ${ETC_FOLDER}/network/interfaces"
fi

if ip link show ${NEPI_WIRED_INTERFACE} &>/dev/null; then
    echo "${NEPI_WIRED_INTERFACE} exists."

    # Update up static IP addr if needed
    static_check=$(ip -4 address show ${NEPI_WIRED_INTERFACE})
    if [[ "$?" -eq 0 ]]; then
        
        echo "Updating Wired Static IP Address"
        file=${ETC_FOLDER}/network/interfaces.d/nepi_static_ip
        sudo cat /dev/null > $file
        echo 'auto '${NEPI_WIRED_INTERFACE} | sudo tee -a $file
        echo 'iface '${NEPI_WIRED_INTERFACE}' inet static' | sudo tee -a $file
        echo '    address '${NEPI_IP}'/24' | sudo tee -a $file
        echo '    gateway '${NEPI_IP%.*}'.1' | sudo tee -a $file

        # Update Network ETC Files
        echo "Updating Network interfaces.d"
        if [ -d "${ETC_FOLDER}/network/interfaces.d" ]; then
            if [ -d "/etc/network/interfaces.d" ]; then
                sudo rm -r /etc/network/interfaces.d
            fi
            sudo cp -a -r ${ETC_FOLDER}/network/interfaces.d /etc/network/
        else
            echo "FAILED TO FIND SOURCE ${ETC_FOLDER}/network/interfaces.d"
        fi

    fi
    sudo ifdown ${NEPI_WIRED_INTERFACE}
    sudo ip addr flush ${NEPI_WIRED_INTERFACE}
    sudo ifup ${NEPI_WIRED_INTERFACE}
fi

